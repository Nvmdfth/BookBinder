# ==========================================
# BookBinder Environment Configuration Example
# ==========================================

# 1. PostgreSQL Database Configuration
POSTGRES_DB=bookbinder
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# 2. Authentication Parameters
JWT_SECRET=super_secret_session_token_key_here
BOOKBINDER_ADMIN_EMAIL=admin@library.com
BOOKBINDER_ADMIN_PASS=secureadminpass123

# 3. Port Settings
PORT=5000

# 4. External Book Lookup Credentials
# (Highly recommended to bypass rate limits (429) on wildcard searches!)
GOOGLE_BOOKS_API_KEY=
