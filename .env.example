# ==========================================
# BookBinder Environment Configuration Example
# ==========================================

# 1. PostgreSQL Database Configuration
POSTGRES_DB=bookbinder
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# 2. Authentication Parameters
JWT_SECRET=super_secret_session_token_key_here
BOOKBINDER_ADMIN_EMAIL=admin@library.com
BOOKBINDER_ADMIN_PASS=secureadminpass123

# 3. Port Settings
PORT=5000

# 4. External Book Lookup Credentials
# (Highly recommended to bypass rate limits (429) on wildcard searches!)
GOOGLE_BOOKS_API_KEY=

# 5. Abuse Protection
# Attempts allowed per client IP per 15 minutes before a 429.
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_ADMIN_MAX=60

# Number of reverse proxies in front of the app. 1 suits a Cloudflare Tunnel
# or a single nginx; use 0 when the container is exposed directly. Setting this
# too high lets a client forge X-Forwarded-For and bypass the rate limits.
TRUST_PROXY_HOPS=1
